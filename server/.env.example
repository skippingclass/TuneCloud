DATABASE_URL=postgresql://tunecloud:tunecloud@localhost:5432/tunecloud
MUSIC_DIR=/home/username/music
PORT=4000
HOST=0.0.0.0
SPOTIFY_CLIENT_ID=your_spotify_id
SPOTIFY_CLIENT_SECRET=your_spotify_secret
# Installation owner's contact email. Leave blank to disable lrc.red requests.
LRC_RED_CONTACT_EMAIL=
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SUBSONIC_ENCRYPTION_KEY=
TRUSTED_PROXIES=
COOKIE_SECURE=false
TAG_EDITING_ENABLED=false

# Optional Last.fm integration. Register YOUR application at https://www.last.fm/api/account/create
# Callback URL: PUBLIC_URL + /settings. HTTPS required except for localhost development.
PUBLIC_URL=
LASTFM_API_KEY=
LASTFM_API_SECRET=
# Stable independent encryption key, at least 32 characters: openssl rand -hex 32
# Keep this key when rotating JWT_SECRET. Changing it requires reconnecting Last.fm accounts.
LASTFM_ENCRYPTION_KEY=

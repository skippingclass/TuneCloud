# ==========================================
# TuneCloud Environment Configuration
# ==========================================

# Port where TuneCloud Web & Subsonic API will be accessible on your host machine
# Example: 80, 3000, 8080
APP_PORT=80

# Absolute path to your music collection on the host machine
# Linux: /home/username/music or /mnt/storage/music
# macOS: /Users/username/Music
# Windows: C:/Users/username/Music
MUSIC_DIR=/home/pirkov/music

# Database configuration (internal to Docker network)
POSTGRES_USER=tunecloud
POSTGRES_PASSWORD=
POSTGRES_DB=tunecloud

# Security: Strong secret key for JWT tokens and encrypting Subsonic passwords
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Initial administrator account (auto-created on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Spotify API (optional: for artist photos and album metadata)
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Contact email for the owner of this installation, sent to lrc.red in User-Agent.
# Leave blank to skip lrc.red and use the other lyrics sources.
LRC_RED_CONTACT_EMAIL=

# Optional stable key for encrypting the SAME password used by Subsonic.
# Set and restart once BEFORE rotating JWT_SECRET to migrate existing Subsonic credentials.
SUBSONIC_ENCRYPTION_KEY=
# Only trust actual reverse proxies. Docker Compose defaults to its private network.
TRUSTED_PROXIES=uniquelocal
# Set true when served over HTTPS. Never enable on an HTTP-only installation.
COOKIE_SECURE=false
# Default library is read-only. To edit MP3 tags, enable BOTH settings:
TAG_EDITING_ENABLED=false
MUSIC_MOUNT_MODE=ro
